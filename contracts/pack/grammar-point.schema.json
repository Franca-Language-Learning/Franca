{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franca.local/spec/grammar-point.schema.json",
  "title": "Franca grammar point (grammar/<key>.yaml)",
  "description": "One grammar point: its place in the grammar graph, its explanation at three depths, its rules with decision or formation steps, and the rules that the answer checker uses. Imported into catalogue_grammar_point_v and the tables that refer to it. Each rule step becomes an item of its own, with the key <rule key>#<step id>, so that a wrong answer can be linked to the step where it went wrong.",
  "type": "object",
  "required": ["key", "title"],
  "additionalProperties": false,
  "$defs": {
    "explanation": {
      "description": "One section of the explanation template, at one depth.",
      "type": "object",
      "required": ["depth", "section", "body_en_md"],
      "additionalProperties": false,
      "properties": {
        "depth": { "enum": ["short", "full", "technical"] },
        "section": {
          "enum": ["concept", "elements", "how_it_works", "variations", "exceptions", "common_errors", "contrast_and_varieties"]
        },
        "body_en_md": { "$ref": "common.schema.json#/$defs/markdown" },
        "body_tl_md": { "$ref": "common.schema.json#/$defs/markdown" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["answer", "action_en"],
      "additionalProperties": false,
      "properties": {
        "answer": { "description": "An answer to the step's question.", "$ref": "common.schema.json#/$defs/english_first" },
        "action_en": { "description": "What the learner does with that answer.", "$ref": "common.schema.json#/$defs/text" },
        "next_step": { "description": "The id of the step that follows this answer. Without it, the rule ends here.", "$ref": "common.schema.json#/$defs/slug" }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "question", "outcomes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "question": { "$ref": "common.schema.json#/$defs/english_first" },
        "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outcome" } }
      }
    },
    "rule": {
      "description": "A rule with steps, for example niet or geen, 't kofschip or a spelling rule. The steps are numbered in the order given.",
      "type": "object",
      "required": ["key", "type", "title", "steps"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/item_key" },
        "type": { "enum": ["decision", "formation", "spelling", "sound_spelling"] },
        "title": { "$ref": "common.schema.json#/$defs/bilingual" },
        "why_en_md": { "description": "Why the rule is as it is, where that helps learners remember it.", "$ref": "common.schema.json#/$defs/markdown" },
        "review_status": { "$ref": "common.schema.json#/$defs/review_status" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tl", "en"],
            "additionalProperties": false,
            "properties": {
              "tl": { "$ref": "common.schema.json#/$defs/text" },
              "en": { "$ref": "common.schema.json#/$defs/text" },
              "step": { "description": "The step the example shows.", "$ref": "common.schema.json#/$defs/slug" },
              "worked": { "description": "true: shown as a worked example, step by step.", "type": "boolean", "default": false }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["note_en"],
            "additionalProperties": false,
            "properties": {
              "lexeme": { "$ref": "common.schema.json#/$defs/item_key" },
              "note_en": { "$ref": "common.schema.json#/$defs/text" },
              "example_tl": { "$ref": "common.schema.json#/$defs/text" }
            }
          }
        }
      }
    },
    "checker_rule": {
      "description": "A rule the answer checker applies before LanguageTool and the model (story E07-002). The fields of a match are defined with the checker; here a rule has an id, the error type it finds, and the step a learner is sent back to.",
      "type": "object",
      "required": ["id", "error_type", "description_en"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "error_type": { "type": "string", "pattern": "^[a-z_]+$" },
        "description_en": { "$ref": "common.schema.json#/$defs/text" },
        "step": { "$ref": "common.schema.json#/$defs/slug" }
      }
    }
  },
  "properties": {
    "key": { "$ref": "common.schema.json#/$defs/item_key" },
    "title": { "$ref": "common.schema.json#/$defs/bilingual" },
    "level": { "$ref": "common.schema.json#/$defs/level" },
    "review_status": { "$ref": "common.schema.json#/$defs/review_status" },
    "requires": {
      "description": "The grammar points that have to be learned first.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/item_key" }
    },
    "explanations": { "type": "array", "items": { "$ref": "#/$defs/explanation" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "checker_rules": { "type": "array", "items": { "$ref": "#/$defs/checker_rule" } }
  }
}
