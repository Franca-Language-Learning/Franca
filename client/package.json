{
  "name": "@franca/client",
  "private": true,
  "version": "0.1.0",
  "description": "Franca's web client: the learner's interface in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "boundaries": "bash scripts/check-boundaries.sh",
    "generate:api": "openapi-typescript ../contracts/openapi.yaml --output src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "dependency-cruiser": "^18.8.0",
    "jsdom": "^31.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
