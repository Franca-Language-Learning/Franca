{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Automatic package updates (story E01-004). Updates wait seven days after release, the same rule as uv and pnpm.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommitTypeAll(chore)"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "timezone": "Europe/Brussels",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Minor and patch updates merge themselves when every check passes.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Major updates wait for a review.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "description": "GitHub Actions updates are grouped into one pull request.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "A uv update can change _virtualenv.py, whose hash is in tools/startup-files-allowed.txt, so it waits for a review.",
      "matchDepNames": [
        "astral-sh/uv"
      ],
      "automerge": false
    },
    {
      "description": "dependency-cruiser cannot read TypeScript 7.0, so the client stays on TypeScript 6 until 7.1.",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7.0.0 || >=7.1.0"
    },
    {
      "description": "Container images are pinned by digest. The tag is kept next to the digest so that people can see the version.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Chromium for the browser tests comes from Playwright's image, which has to match the version of @playwright/test, so the two are updated together.",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "Playwright"
    },
    {
      "description": "Source code built in the Dockerfiles waits for a review, because the build flags in the same stage can name the version.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The uv version pinned in pyproject.toml and the workflows.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^pyproject\\.toml$/"
      ],
      "matchStrings": [
        "(?:version: |required-version = )\"(?:==)?(?<currentValue>[0-9][^\"]*)\" # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Images pulled by the rehearsal scripts, marked with a renovate comment. Renovate adds their digests, as for the Dockerfiles.",
      "managerFilePatterns": [
        "/^infra/tests/.+\\.py$/"
      ],
      "matchStrings": [
        "= \"(?<depName>[a-z0-9./-]+):(?<currentValue>[^\"@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\"  # renovate: image"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "= \"{{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\"  # renovate: image"
    },
    {
      "customType": "regex",
      "description": "Images named in the workflows, marked with a renovate comment.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        ": \"(?<depName>[a-z0-9./-]+):(?<currentValue>[^\"@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\"  # renovate: image"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": ": \"{{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\"  # renovate: image"
    },
    {
      "customType": "regex",
      "description": "Source code cloned in the Dockerfiles: the release tag and the commit it is checked against.",
      "managerFilePatterns": [
        "/^infra/images/.+Dockerfile$/"
      ],
      "matchStrings": [
        "--branch (?<currentValue>\\S+) https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)[^\\n]*\\n(?:[^\\n]*\\n)?\\s*&& test \"\\$\\(git rev-parse HEAD\\)\" = (?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
