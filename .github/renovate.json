{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Automatic package updates (story E01-004). Updates wait seven days after release, the same rule as uv and pnpm.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommitTypeAll(chore)"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "timezone": "Europe/Brussels",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Minor and patch updates merge themselves when every check passes.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Major updates wait for a review.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "description": "GitHub Actions updates are grouped into one pull request.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "A uv update can change _virtualenv.py, whose hash is in tools/startup-files-allowed.txt, so it waits for a review.",
      "matchDepNames": [
        "astral-sh/uv"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The uv version pinned in pyproject.toml and the workflows.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^pyproject\\.toml$/"
      ],
      "matchStrings": [
        "(?:version: |required-version = )\"(?:==)?(?<currentValue>[0-9][^\"]*)\" # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    }
  ]
}
