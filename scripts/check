#!/usr/bin/env bash
# Runs the same checks as the pipeline, on this checkout. The python and client parts are run in the pipeline through
# this script too, so each list of files and folders below is the one used in the pipeline.
#
#   scripts/check                  all parts, in the order listed under Parts
#   scripts/check python client    some parts
#
# Parts: guard (content guard), secrets (gitleaks over the history of the checked-out commit), python (server,
# contracts, tools, infra and installer), windows (the Windows installer, when pwsh is installed), client, browser
# (browser tests).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
root="$(pwd)"

step() { printf '\n== %s\n' "$1"; }

# The Python code that is linted and formatted, and the stand-alone scripts that are type-checked with mypy --strict
# (the server code is listed in server/pyproject.toml). The paths are relative to server/.
python_paths=(. ../contracts ../tools ../infra/updater ../infra/backup ../infra/tests ../installer/linux)
strict_scripts=(
    ../tools/content_guard.py
    ../tools/check_pins.py
    ../tools/check_harden_runner.py
    ../tools/install_program.py
    ../tools/update_pester_hash.py
    ../tools/validate_pack.py
    ../infra/updater/franca_updater.py
    ../infra/backup/franca_backup.py
    ../infra/tests/rehearse_update.py
    ../infra/tests/rehearse_backup.py
    ../infra/tests/rehearse_tailnet.py
    ../infra/tests/rehearse_status.py
    ../installer/linux/franca_install.py
    ../infra/tests/rehearse_install.py
)

check_guard() {
    step "Content guard"
    python3 -I tools/content_guard.py --index
}

check_secrets() {
    step "Secrets in the history"
    # gitleaks is downloaded once and checked against its SHA-256 in tools/programs.txt. After that, the scan needs no
    # network. Findings that were checked and are not secrets are listed in .gitleaksignore (docs/secret-scanning.md).
    # The exit codes of install_program.py: 3 for a download with another hash, 4 for another platform.
    local gitleaks status=0
    gitleaks="$(python3 -I tools/install_program.py gitleaks)" || status=$?
    if [ "$status" -eq 3 ] || { [ "$status" -ne 0 ] && [ -n "${GITHUB_ACTIONS:-}" ]; }; then
        return 1
    elif [ "$status" -ne 0 ]; then
        echo "gitleaks could not be used on this computer (the reason is above), so the secret scan runs in the pipeline only."
        return 0
    fi
    "$gitleaks" git --redact --verbose --no-banner --log-opts=HEAD .
}

check_python() {
    step "Python packages"
    uv sync --locked --quiet
    tools/check-startup-files.sh .venv

    cd "$root/server"
    step "Lint and format"
    uv run ruff check "${python_paths[@]}"
    uv run ruff format --check "${python_paths[@]}"
    step "Type check"
    uv run mypy
    uv run mypy --strict "${strict_scripts[@]}"
    step "Module boundaries"
    PYTHONPATH=src uv run lint-imports
    step "Server, contract and tool tests"
    uv run pytest
    step "Fixture pack"
    uv run python -I ../tools/validate_pack.py ../packs/fixture
    step "Shell scripts"
    uv run shellcheck ../tools/*.sh ../.githooks/* ../scripts/* ../client/scripts/*.sh ../infra/tests/*.sh ../infra/*/entrypoint.sh
    step "Workflow security"
    # In the pipeline, zizmor also asks GitHub about the actions that the workflows use, with the job's token (GH_TOKEN).
    if [ -n "${GITHUB_ACTIONS:-}" ]; then
        uv run zizmor ../.github
    else
        uv run zizmor --offline ../.github
    fi
    step "Harden-Runner settings"
    uv run python -I ../tools/check_harden_runner.py
    cd "$root"
}

check_windows() {
    step "Windows installer"
    if command -v pwsh >/dev/null 2>&1; then
        pwsh -NoProfile -Command "Invoke-ScriptAnalyzer -Path installer/windows -Recurse -Settings installer/windows/PSScriptAnalyzerSettings.psd1 -EnableExit; Invoke-Pester -Path installer/windows/tests -CI"
    else
        echo "PowerShell (pwsh) is not installed here, so the Windows installer is checked in the pipeline only."
    fi
}

check_client() {
    step "Client"
    pnpm install --frozen-lockfile --silent
    pnpm --filter @franca/client generate:api >/dev/null
    git diff --exit-code -- client/src/api/schema.d.ts
    pnpm --filter @franca/client typecheck
    pnpm --filter @franca/client boundaries
    pnpm --filter @franca/client test
    pnpm --filter @franca/client build
}

check_browser() {
    step "Browser tests"
    pnpm --filter @franca/client e2e
}

parts=("$@")
if [ ${#parts[@]} -eq 0 ]; then
    parts=(guard secrets python windows client browser)
fi
for part in "${parts[@]}"; do
    case "$part" in
        guard | secrets | python | windows | client | browser) "check_$part" ;;
        *)
            echo "Unknown part: $part. The parts are guard, secrets, python, windows, client and browser." >&2
            exit 2
            ;;
    esac
done

printf '\nAll checks passed (%s).\n' "${parts[*]}"
