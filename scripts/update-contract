#!/usr/bin/env bash
# Writes the server's API description to contracts/openapi.yaml, and the client's API types from it.
# Run after changing a route.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../server"
PYTHONPATH=src uv run python -m franca.api.export_openapi
cd ..
pnpm --filter @franca/client generate:api
