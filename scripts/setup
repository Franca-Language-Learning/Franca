#!/usr/bin/env bash
# Sets up a checkout for development: the Git hooks, the Python packages and the npm packages.
# Run once after cloning:  scripts/setup
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

git config core.hooksPath .githooks
echo "Git hooks: .githooks (the content guard runs before each commit and push)"

uv sync --locked
tools/check-startup-files.sh .venv

pnpm install --frozen-lockfile
# The browser tests need Chromium. If Chromium is already on this computer, put its path in FRANCA_CHROMIUM and
# this step is skipped.
if [ -z "${FRANCA_CHROMIUM:-}" ]; then
    pnpm --filter @franca/client exec playwright install chromium
fi
echo "Set up. Run scripts/check to run every check."
